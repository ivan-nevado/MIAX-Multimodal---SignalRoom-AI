# Optional remote state for team work. Create the bucket once (versioned, private), then:
#   cp backend.tf.example backend.tf && terraform init -migrate-state
terraform {
  backend "s3" {
    bucket       = "signalroom-tfstate-<your-account-id>"
    key          = "dev/terraform.tfstate"
    region       = "eu-west-1"
    use_lockfile = true
    encrypt      = true
  }
}
