# SignalRoom AI — environment variables (names only; NEVER commit real values).
# Copy to `.env` for local development. In AWS, API keys live in AWS Secrets Manager
# (see scripts/set_secrets.sh) and the rest is set by Terraform on the ECS tasks.

# ---- Runtime ---------------------------------------------------------------
APP_ENV=local                 # local | dev | prod | test
BACKEND_MODE=local            # local (files + in-process worker) | aws (DynamoDB/S3/SQS/SES)
AUTH_MODE=local               # local (dev JWT) | cognito
LOG_LEVEL=INFO

# ---- AI providers (one OpenRouter key gives access to every model) -----------
OPENROUTER_API_KEY=
# Optional direct providers (used only when OPENROUTER_API_KEY is empty)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model routing (defaults shown; OpenRouter model IDs)
OPENAI_MODEL=openai/gpt-6-luna
GEMINI_MULTIMODAL_MODEL=google/gemini-3.8-flash
GEMINI_TRANSCRIBE_MODEL=google/gemini-3.8-flash
TTS_MODEL=openai/gpt-audio-mini
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
IMAGE_MODEL=google/gemini-3.1-flash-image
EMBEDDING_MODEL=google/gemini-embedding-2

# ---- Data providers ---------------------------------------------------------
ALPHAVANTAGE_API_KEY=         # optional, free key
FRED_API_KEY=                 # optional, free key
SEC_USER_AGENT="SignalRoom AI academic prototype (contact: you@example.com)"
GDELT_ENABLED=true

# ---- AWS (BACKEND_MODE=aws) ----------------------------------------------------
AWS_REGION=eu-west-1
DYNAMODB_TABLE_PREFIX=signalroom-dev
S3_BUCKET=
SQS_INVESTIGATION_QUEUE_URL=
SQS_BRIEFING_QUEUE_URL=
SECRETS_MANAGER_SECRET_ID=
SES_FROM_EMAIL=

# ---- Cognito (AUTH_MODE=cognito) ----------------------------------------------
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=eu-west-1

# ---- Budget protection ---------------------------------------------------------
ALLOWED_EMAILS=               # e.g. ana@gmail.com,luis@gmail.com,@miax.es  (empty = open sign-up)
MAX_INVESTIGATIONS_PER_DAY=20
MAX_BRIEFINGS_PER_DAY=5

# ---- URLs --------------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOCAL_JWT_SECRET=change-me-local-dev-only

# ---- Frontend (Vite; only public, safe values) -----------------------------------
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=eu-west-1
VITE_APP_ENV=local
VITE_DEMO_MODE=false
